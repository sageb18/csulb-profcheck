{
  "manifest_version": 3,
  "name": "CSULB ProfCheck",
  "version": "1.0.0",
  "description": "Shows Rate My Professors ratings next to instructor names on the CSULB class search page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cmsweb.cms.csulb.edu/psc/CLBPRD/EMPLOYEE/SA/c/*"],
      "js": ["dist/content.js"],
      "css": ["dist/styles.css"]
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": ["https://www.ratemyprofessors.com/*"]
}
